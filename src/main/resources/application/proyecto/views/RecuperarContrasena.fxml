<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.RecuperarContrasenaController"
            prefWidth="470.0"
            prefHeight="560.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12.0"
              prefHeight="50.0"
              style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
            </padding>

            <Label text="Recuperar contrasena">
                <font>
                    <Font name="Arial Black" size="16.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" style="-fx-background-color: #f4f6fb;">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <VBox spacing="4.0">
                <Label text="Recuperacion de cuenta"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                <Label text="Ingresa tu numero de empleado y responde tus preguntas de seguridad"
                       wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
            </VBox>

            <VBox spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                <padding>
                    <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                </padding>

                <Label text="Usuario"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

                <HBox spacing="10.0">
                    <TextField fx:id="txtUsuarioRecuperacion"
                               promptText="No. empleado"
                               prefHeight="38.0"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                    <Button fx:id="btnBuscarPreguntas"
                            text="Buscar"
                            onAction="#handleBuscarPreguntas"
                            prefHeight="38.0"
                            prefWidth="100.0"
                            style="-fx-background-color: #6574c4; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                </HBox>

                <Label text="Preguntas de recuperacion"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

                <ComboBox fx:id="cbPregunta1Recuperacion"
                          promptText="Pregunta 1"
                          prefHeight="38.0"
                          maxWidth="1.7976931348623157E308" />

                <TextField fx:id="txtRespuesta1Recuperacion"
                           promptText="Respuesta 1"
                           prefHeight="38.0"
                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                <ComboBox fx:id="cbPregunta2Recuperacion"
                          promptText="Pregunta 2"
                          prefHeight="38.0"
                          maxWidth="1.7976931348623157E308" />

                <TextField fx:id="txtRespuesta2Recuperacion"
                           promptText="Respuesta 2"
                           prefHeight="38.0"
                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                <Label text="Nueva contrasena"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

                <PasswordField fx:id="txtNuevaContrasenaRecuperacion"
                               promptText="Nueva contrasena"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                <PasswordField fx:id="txtConfirmarContrasenaRecuperacion"
                               promptText="Confirmar contrasena"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnCancelar"
                            text="Cancelar"
                            onAction="#handleCancelar"
                            prefHeight="38.0"
                            prefWidth="110.0"
                            style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 8; -fx-cursor: hand;" />

                    <Button fx:id="btnActualizarContrasena"
                            text="Actualizar"
                            onAction="#handleRecuperarContrasena"
                            prefHeight="38.0"
                            prefWidth="130.0"
                            style="-fx-background-color: #1F2A44; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>