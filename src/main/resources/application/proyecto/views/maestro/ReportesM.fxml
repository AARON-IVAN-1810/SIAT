<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="900.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #e5e8f2;">

   <top>
      <HBox alignment="CENTER_LEFT"
            spacing="12.0"
            prefHeight="50.0"
            style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Reportes">
            <font>
               <Font name="Arial Black" size="15.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox alignment="CENTER_LEFT"
               spacing="6.0"
               style="-fx-background-color: #eaf1fb; -fx-background-radius: 8;"
               prefHeight="32.0">
            <padding>
               <Insets left="8.0" right="8.0"/>
            </padding>

            <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoLupa.png" />
               </image>
            </ImageView>

            <TextField fx:id="txtBuscarSuperior"
                       promptText="Buscar alumno, grupo ..."
                       prefWidth="180.0"
                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;">
               <font>
                  <Font size="13.0"/>
               </font>
            </TextField>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <VBox spacing="15.0" style="-fx-background-color: #e5e8f2;">
         <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
         </padding>

         <!-- encabezado -->
         <VBox spacing="2.0">
            <Label text="Reportes">
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>

            <Label text="Generacion y seguimiento de reportes del maestro" textFill="#7a7a7a">
               <font>
                  <Font name="Arial Bold Italic" size="11.0" />
               </font>
            </Label>
         </VBox>

         <!-- panel principal -->
         <VBox spacing="14.0"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 15;">
            <padding>
               <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
            </padding>

            <Label text="Generar reporte">
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>

            <!-- formulario -->
            <HBox spacing="14.0">
               <VBox spacing="8.0">
                  <Label text="Materia" textFill="#6b7280">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbMateria"
                            prefHeight="38.0"
                            prefWidth="170.0"
                            promptText="Seleccione materia" />
               </VBox>

               <VBox spacing="8.0">
                  <Label text="Grupo" textFill="#6b7280">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbGrupo"
                            prefHeight="38.0"
                            prefWidth="150.0"
                            promptText="Seleccione grupo" />
               </VBox>

               <VBox spacing="8.0">
                  <Label text="Turno" textFill="#6b7280">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtTurno"
                             editable="false"
                             focusTraversable="false"
                             prefHeight="38.0"
                             prefWidth="130.0"
                             promptText="Automatico"
                             style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-border-color: #d1d5db; -fx-border-radius: 8;" />
               </VBox>

               <VBox spacing="8.0">
                  <Label text="Alumno" textFill="#6b7280">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbAlumno"
                            prefHeight="38.0"
                            prefWidth="210.0"
                            promptText="Seleccione alumno" />
               </VBox>

               <VBox spacing="8.0">
                  <Label text="Motivo" textFill="#6b7280">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbMotivo"
                            prefHeight="38.0"
                            prefWidth="180.0"
                            promptText="Seleccione motivo" />
               </VBox>
            </HBox>

            <VBox spacing="8.0">
               <Label text="Descripcion del reporte" textFill="#6b7280">
                  <font>
                     <Font size="12.0" />
                  </font>
               </Label>

               <TextArea fx:id="txtDescripcion"
                         prefHeight="110.0"
                         promptText="Describe por que se esta generando el reporte. Ejemplo: el alumno presenta ausencias repetidas, no entrega actividades o mantiene bajo rendimiento en la materia..."
                         wrapText="true" />
            </VBox>

            <HBox alignment="CENTER_RIGHT">
               <Button fx:id="btnGenerarReporte"
                       prefHeight="42.0"
                       prefWidth="190.0"
                       style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;"
                       text="Generar reporte">
                  <font>
                     <Font name="Arial Bold" size="13.0" />
                  </font>
               </Button>
            </HBox>

            <Label text="Reportes generados">
               <font>
                  <Font name="Arial Black" size="16.0" />
               </font>
            </Label>

            <!-- barra interna de filtros -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <ComboBox fx:id="cbFiltroMateria"
                         prefHeight="36.0"
                         prefWidth="150.0"
                         promptText="Materia" />

               <ComboBox fx:id="cbFiltroMotivo"
                         prefHeight="36.0"
                         prefWidth="150.0"
                         promptText="Motivo" />

               <ComboBox fx:id="cbFiltroEstado"
                         prefHeight="36.0"
                         prefWidth="150.0"
                         promptText="Estado" />

               <HBox alignment="CENTER_LEFT"
                     spacing="8.0"
                     style="-fx-background-color: white; -fx-border-color: #d9dce5; -fx-border-radius: 8; -fx-background-radius: 8;"
                     HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets top="0.0" right="10.0" bottom="0.0" left="10.0" />
                  </padding>

                  <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                     <image>
                        <Image url="@../../fotos/IconoLupa.png" />
                     </image>
                  </ImageView>

                  <TextField fx:id="txtBuscarTabla"
                             promptText="Buscar por alumno, grupo o materia..."
                             style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                             HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </TextField>
               </HBox>
            </HBox>

            <!-- tabla -->
            <TableView fx:id="tablaReportes"
                       VBox.vgrow="ALWAYS"
                       prefHeight="260.0">
               <columns>
                  <TableColumn fx:id="colNoControl" text="No. Control" prefWidth="110.0" />
                  <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170.0" />
                  <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="90.0" />
                  <TableColumn fx:id="colTurno" text="Turno" prefWidth="90.0" />
                  <TableColumn fx:id="colMateria" text="Materia" prefWidth="130.0" />
                  <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="120.0" />
                  <TableColumn fx:id="colDescripcion" text="Descripcion" prefWidth="240.0" />
                  <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </VBox>
      </VBox>
   </center>
</BorderPane>