<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.maestros.PerfilUsuarioMController"
            prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #f4f6fb;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
            </padding>

            <Label text="Mi Perfil">
                <font>
                    <Font name="Arial Black" size="17.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../fotos/IconoSalir.png"/>
                    </image>
                </ImageView>

                <Button text="Cerrar Sesion"
                        onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <font>
                        <Font name="Arial Black" size="12.0"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <VBox spacing="4.0">
                <Label text="Configuracion de usuario"
                       style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                <Label text="Administra tu informacion personal, contrasena y recuperacion de cuenta"
                       style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
            </VBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                <VBox prefWidth="310.0"
                      spacing="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                    <padding>
                        <Insets top="18.0" right="16.0" bottom="16.0" left="16.0"/>
                    </padding>

                    <Label text="Datos del perfil"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                    <TextField fx:id="txtNombre"
                               promptText="Nombre"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <TextField fx:id="txtApellidoPaterno"
                               promptText="Apellido paterno"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <TextField fx:id="txtApellidoMaterno"
                               promptText="Apellido materno"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <TextField fx:id="txtNumEmpleado"
                               promptText="Numero de empleado"
                               editable="false"
                               prefHeight="38.0"
                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <TextField fx:id="txtCorreo"
                               promptText="Correo institucional"
                               editable="false"
                               prefHeight="38.0"
                               style="-fx-background-color: #e5e7eb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <TextField fx:id="txtTelefono"
                               promptText="Telefono"
                               prefHeight="38.0"
                               style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

                    <Button text="Guardar datos personales"
                            fx:id="btnGuardarDatos"
                            onAction="#handleGuardarDatos"
                            prefHeight="40.0"
                            maxWidth="1.7976931348623157E308"
                            style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

                <VBox spacing="14.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                    </padding>

                    <VBox spacing="4.0">
                        <Label text="Seguridad de la cuenta"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <Label text="Actualiza tu contrasena y configura dos preguntas para recuperar el acceso"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                    </VBox>

                    <Separator/>

                    <VBox spacing="12.0">
                        <Label text="Cambiar contrasena"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <HBox spacing="12.0">
                            <PasswordField fx:id="txtActual"
                                           promptText="Contrasena actual"
                                           prefHeight="38.0"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                            <PasswordField fx:id="txtNueva"
                                           promptText="Nueva contrasena"
                                           prefHeight="38.0"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />
                        </HBox>

                        <PasswordField fx:id="txtConfirmar"
                                       promptText="Confirmar nueva contrasena"
                                       prefHeight="38.0"
                                       maxWidth="1.7976931348623157E308"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                        <Button text="Actualizar contrasena"
                                fx:id="btnCambiarContrasena"
                                onAction="#handleCambiarContrasena"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #6574c4; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                    </VBox>

                    <Separator/>

                    <VBox spacing="12.0">
                        <Label text="Preguntas de recuperacion"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <HBox spacing="12.0">
                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <ComboBox fx:id="cbPregunta1"
                                          promptText="Pregunta 1"
                                          prefHeight="38.0"
                                          maxWidth="1.7976931348623157E308" />

                                <TextField fx:id="txtRespuesta1"
                                           promptText="Respuesta 1"
                                           prefHeight="38.0"
                                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />
                            </VBox>

                            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                <ComboBox fx:id="cbPregunta2"
                                          promptText="Pregunta 2"
                                          prefHeight="38.0"
                                          maxWidth="1.7976931348623157E308" />

                                <TextField fx:id="txtRespuesta2"
                                           promptText="Respuesta 2"
                                           prefHeight="38.0"
                                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />
                            </VBox>
                        </HBox>

                        <Label text="Debes configurar dos preguntas diferentes para recuperar tu cuenta."
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />

                        <Button text="Guardar preguntas"
                                fx:id="btnGuardarPreguntas"
                                onAction="#handleGuardarPreguntas"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #6956cc; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>