<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.ImportacionClasesJDMController"
            prefWidth="1000.0"
            prefHeight="700.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
            </padding>

            <Label text="Importacion de Clases">
                <font>
                    <Font name="Arial Black" size="17.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../fotos/IconoSalir.png"/>
                    </image>
                </ImageView>

                <Button text="Cerrar Sesion"
                        onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <font>
                        <Font name="Arial Black" size="12.0"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">

            <content>
                <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                    </padding>

                    <VBox spacing="4.0">
                        <Label text="Importacion de Clases"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Sube el archivo oficial, valida las clases importadas y genera el link de seleccion para maestros."
                               style="-fx-font-size: 16px; -fx-text-fill: #6b7280;"/>
                    </VBox>

                    <HBox spacing="14.0">
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                            </padding>
                            <Label text="Total filas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblTotalFilas" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                            </padding>
                            <Label text="Validadas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblFilasValidas" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                            </padding>
                            <Label text="Pendientes" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblFilasPendientes" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                            </padding>
                            <Label text="Cargadas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblFilasCargadas" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </VBox>

                        <VBox spacing="5.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                            </padding>
                            <Label text="Links abiertos" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblLinksAbiertos" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

                        <VBox prefWidth="500.0"
                              spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="18.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>

                            <Label text="Subir archivo"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                            <Label text="Ciclo escolar" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <ComboBox fx:id="cbCicloEscolar"
                                      promptText="Selecciona un ciclo"
                                      prefHeight="38.0"
                                      maxWidth="1.7976931348623157E308"/>

                            <Label text="Nombre del lote" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <TextField fx:id="txtNombreLote"
                                       promptText="Ejemplo: cargas agosto diciembre"
                                       prefHeight="38.0"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                            <Label text="Archivo" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <HBox spacing="8.0">
                                <TextField fx:id="txtArchivo"
                                           promptText="Selecciona archivo xlsx, csv o pdf"
                                           editable="false"
                                           prefHeight="38.0"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>
                                <Button fx:id="btnSeleccionarArchivo"
                                        text="Buscar"
                                        onAction="#handleSeleccionarArchivo"
                                        prefHeight="38.0"
                                        style="-fx-background-color: #6ea8e5; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>

                            <Label text="Notas" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <TextArea fx:id="txtNotasLote"
                                      promptText="Notas internas de la importacion"
                                      prefRowCount="3"
                                      wrapText="true"
                                      style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                            <Button fx:id="btnImportarArchivo"
                                    text="Importar archivo"
                                    onAction="#handleImportarArchivo"
                                    prefHeight="40.0"
                                    maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

                            <Button fx:id="btnValidarLote"
                                    text="Validar lote seleccionado"
                                    onAction="#handleValidarLote"
                                    prefHeight="38.0"
                                    maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: linear-gradient(to right, #6f7bc7, #5f6ebb); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"/>

                            <Button fx:id="btnLimpiarFormulario"
                                    text="Limpiar formulario"
                                    onAction="#handleLimpiarFormulario"
                                    prefHeight="36.0"
                                    maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"/>

                            <Separator/>

                            <Label text="Generar link"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                            <Label text="Lote seleccionado" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblLoteSeleccionado"
                                   text="Selecciona un lote"
                                   wrapText="true"
                                   style="-fx-font-size: 12px; -fx-text-fill: #111827;"/>

                            <Label text="URL base" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <TextField fx:id="txtUrlBase"
                                       promptText="http://192.168.1.65/siat"
                                       prefHeight="38.0"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                            <Label text="Fecha limite" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <DatePicker fx:id="dpFechaLimite"
                                        promptText="Opcional"
                                        prefHeight="38.0"
                                        maxWidth="1.7976931348623157E308"/>

                            <Label text="Notas del link" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <TextArea fx:id="txtNotasLink"
                                      promptText="Notas internas del link"
                                      prefRowCount="3"
                                      wrapText="true"
                                      style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                            <Button fx:id="btnGenerarLink"
                                    text="Generar link para maestros"
                                    onAction="#handleGenerarLink"
                                    prefHeight="40.0"
                                    maxWidth="1.7976931348623157E308"
                                    style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>

                            <Separator/>

                            <Label text="Detalle del link"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                            <Label text="Link completo" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <TextArea fx:id="txtLinkCompleto"
                                      editable="false"
                                      wrapText="true"
                                      prefRowCount="3"
                                      style="-fx-background-color: #f4f6fb; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                            <GridPane hgap="8.0" vgap="8.0">
                                <Button fx:id="btnCopiarLink"
                                        text="Copiar"
                                        onAction="#handleCopiarLink"
                                        prefHeight="36.0"
                                        maxWidth="1.7976931348623157E308"
                                        style="-fx-background-color: #6ea8e5; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"
                                        GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                                <Button fx:id="btnCerrarLink"
                                        text="Cerrar"
                                        onAction="#handleCerrarLink"
                                        prefHeight="36.0"
                                        maxWidth="1.7976931348623157E308"
                                        style="-fx-background-color: linear-gradient(to right, #7762d9, #6956cc); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"
                                        GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                    <ColumnConstraints hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>

                            <Label text="Estado del link" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <Label fx:id="lblEstadoLink"
                                   text="---"
                                   wrapText="true"
                                   style="-fx-font-size: 12px; -fx-text-fill: #111827;"/>
                        </VBox>

                        <VBox spacing="14.0" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent;">

                            <VBox spacing="10.0"
                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                                <padding>
                                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Lotes importados"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                                    <Region HBox.hgrow="ALWAYS"/>

                                    <Button fx:id="btnActualizar"
                                            text="Actualizar"
                                            onAction="#handleActualizar"
                                            prefHeight="36.0"
                                            style="-fx-background-color: #6ea8e5; -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"/>
                                </HBox>

                                <TableView fx:id="tablaLotes" prefHeight="180.0">
                                    <columns>
                                        <TableColumn fx:id="colLoteNombre" text="Lote" prefWidth="190.0"/>
                                        <TableColumn fx:id="colLoteArchivo" text="Archivo" prefWidth="160.0"/>
                                        <TableColumn fx:id="colLoteCiclo" text="Ciclo" prefWidth="110.0"/>
                                        <TableColumn fx:id="colLoteTotal" text="Filas" prefWidth="70.0"/>
                                        <TableColumn fx:id="colLoteValidas" text="Validas" prefWidth="80.0"/>
                                        <TableColumn fx:id="colLotePendientes" text="Pendientes" prefWidth="95.0"/>
                                        <TableColumn fx:id="colLoteCargadas" text="Cargadas" prefWidth="90.0"/>
                                        <TableColumn fx:id="colLoteEstado" text="Estado" prefWidth="90.0"/>
                                        <TableColumn fx:id="colLoteFecha" text="Fecha" prefWidth="140.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <VBox VBox.vgrow="ALWAYS"
                                  spacing="12.0"
                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                                <padding>
                                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="Clases importadas"
                                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                                    <Region HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <HBox alignment="CENTER_LEFT"
                                          spacing="8.0"
                                          style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;"
                                          HBox.hgrow="ALWAYS">
                                        <padding>
                                            <Insets top="0.0" right="12.0" bottom="0.0" left="12.0"/>
                                        </padding>

                                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../../fotos/IconoLupa.png"/>
                                            </image>
                                        </ImageView>

                                        <TextField fx:id="txtBuscarDetalle"
                                                   promptText="Buscar por grupo, materia, paquete, docente o estatus..."
                                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                                   HBox.hgrow="ALWAYS"/>
                                    </HBox>

                                    <ComboBox fx:id="cbEstatusFiltro"
                                              promptText="Estatus"
                                              prefHeight="38.0"
                                              prefWidth="170.0"/>
                                </HBox>

                                <TableView fx:id="tablaDetalle"
                                           VBox.vgrow="ALWAYS"
                                           prefHeight="400.0">
                                    <columns>
                                        <TableColumn fx:id="colFila" text="Fila" prefWidth="60.0"/>
                                        <TableColumn fx:id="colGrupoDocumento" text="Grupo doc." prefWidth="110.0"/>
                                        <TableColumn fx:id="colMateriaDocumento" text="Materia doc." prefWidth="190.0"/>
                                        <TableColumn fx:id="colPaqueteDocumento" text="Paquete" prefWidth="85.0"/>
                                        <TableColumn fx:id="colDocenteDocumento" text="Docente doc." prefWidth="170.0"/>
                                        <TableColumn fx:id="colSemestreDetectado" text="Sem." prefWidth="65.0"/>
                                        <TableColumn fx:id="colMateriaDetectada" text="Materia detectada" prefWidth="180.0"/>
                                        <TableColumn fx:id="colGrupoDetectado" text="Grupo" prefWidth="90.0"/>
                                        <TableColumn fx:id="colMaestroDetectado" text="Maestro" prefWidth="170.0"/>
                                        <TableColumn fx:id="colEstatusImportacion" text="Estatus" prefWidth="135.0"/>
                                        <TableColumn fx:id="colObservaciones" text="Observaciones" prefWidth="220.0"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="10.0"
                                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                                <padding>
                                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                                </padding>

                                <Label text="Links de seleccion generados"
                                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                                <TableView fx:id="tablaLinks" prefHeight="170.0">
                                    <columns>
                                        <TableColumn fx:id="colLinkLote" text="Lote" prefWidth="190.0"/>
                                        <TableColumn fx:id="colLinkCiclo" text="Ciclo" prefWidth="110.0"/>
                                        <TableColumn fx:id="colLinkFechaLimite" text="Fecha limite" prefWidth="125.0"/>
                                        <TableColumn fx:id="colLinkDisponibles" text="Disponibles" prefWidth="100.0"/>
                                        <TableColumn fx:id="colLinkCargadas" text="Cargadas" prefWidth="90.0"/>
                                        <TableColumn fx:id="colLinkEstado" text="Estado" prefWidth="95.0"/>
                                        <TableColumn fx:id="colLinkCreado" text="Creado" prefWidth="140.0"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>