<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0"
            prefWidth="1200.0"
            style="-fx-background-color: #eef2f7;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.proyecto.controllers.jefedemaestros.OrientacionSinTutorJDMController">

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="55.0"
              spacing="10.0"
              style="-fx-background-color: white;">
            <padding>
                <Insets bottom="10.0" left="18.0" right="18.0" top="10.0" />
            </padding>

            <Label text="Orientacion - grupos sin tutor">
                <font>
                    <Font name="Arial Black" size="16.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                <image>
                    <Image url="@../../fotos/IconoSalir.png" />
                </image>
            </ImageView>

            <Button onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="Cerrar Sesion">
                <font>
                    <Font name="Arial Bold" size="12.0" />
                </font>
            </Button>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: #eef2f7;">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>

                    <VBox spacing="4.0">
                        <Label text="Orientacion y seguimiento del alumno"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <Label text="Registra acuerdos, contexto e intervenciones realizadas con alumnos de grupos sin tutor"
                               style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18;">
                        <padding>
                            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                        </padding>

                        <VBox spacing="3.0">
                            <Label text="Datos del estudiante para intervencion"
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold;" />

                            <Label text="Selecciona un grupo sin tutor y un alumno, o revisa los datos cargados desde una alerta seleccionada."
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
                        </VBox>

                        <GridPane hgap="12.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>

                            <ComboBox fx:id="cmbGrupo"
                                      maxWidth="1.7976931348623157E308"
                                      prefHeight="38.0"
                                      promptText="Grupo sin tutor"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0" />

                            <ComboBox fx:id="cmbAlumno"
                                      maxWidth="1.7976931348623157E308"
                                      prefHeight="38.0"
                                      promptText="Seleccionar alumno"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0" />

                            <TextField fx:id="txtSemestre"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Semestre"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0" />

                            <TextField fx:id="txtTurno"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Turno"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0" />

                            <TextField fx:id="txtMateria"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Materia"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="1" />

                            <TextField fx:id="txtTipoAlerta"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Tipo de alerta"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1" />

                            <TextField fx:id="txtPrioridad"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Prioridad"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="1" />

                            <TextField fx:id="txtFechaAlerta"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Fecha alerta"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="1" />

                            <TextField fx:id="txtFechaOrientacion"
                                       editable="false"
                                       prefHeight="38.0"
                                       promptText="Fecha orientacion"
                                       style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="2" />

                            <ComboBox fx:id="cmbTipoIntervencion"
                                      maxWidth="1.7976931348623157E308"
                                      prefHeight="38.0"
                                      promptText="Tipo de intervencion"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="2" />

                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18;">
                        <padding>
                            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                        </padding>

                        <VBox spacing="3.0">
                            <Label text="Registro de orientacion"
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold;" />

                            <Label text="Captura los acuerdos y el contexto de la intervencion realizada con el estudiante."
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
                        </VBox>

                        <TextArea fx:id="txtAcuerdos"
                                  prefHeight="90.0"
                                  promptText="Acuerdos con el estudiante..."
                                  style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                  wrapText="true" />

                        <TextArea fx:id="txtDescripcionOrientacion"
                                  prefHeight="110.0"
                                  promptText="Descripcion o contexto de la orientacion..."
                                  style="-fx-background-color: #eef3fb; -fx-background-radius: 8;"
                                  wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <Button fx:id="btnRegistrarIntervencion"
                                    onAction="#handleRegistrarIntervencion"
                                    prefHeight="40.0"
                                    prefWidth="190.0"
                                    style="-fx-background-color: #6d5be3; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;"
                                    text="Registrar intervencion" />

                            <Button fx:id="btnVerAlertas"
                                    onAction="#handleVerAlertas"
                                    prefHeight="40.0"
                                    prefWidth="190.0"
                                    style="-fx-background-color: white; -fx-border-color: #d8dce6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"
                                    text="Ver alertas sin tutor" />
                        </HBox>
                    </VBox>

                    <VBox spacing="14.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18;">
                        <padding>
                            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                        </padding>

                        <VBox spacing="3.0">
                            <Label text="Tabla de intervenciones registradas"
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold;" />

                            <Label text="Historial de intervenciones realizadas para el alumno seleccionado."
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
                        </VBox>

                        <TableView fx:id="tablaIntervencionesTutor" prefHeight="260.0">
                            <columns>
                                <TableColumn fx:id="colAlumnoIntervencion" prefWidth="190.0" text="Alumno" />
                                <TableColumn fx:id="colGrupoIntervencion" prefWidth="90.0" text="Grupo" />
                                <TableColumn fx:id="colFechaIntervencion" prefWidth="110.0" text="Fecha" />
                                <TableColumn fx:id="colTipoIntervencion" prefWidth="160.0" text="Tipo intervencion" />
                                <TableColumn fx:id="colAcuerdosIntervencion" prefWidth="280.0" text="Acuerdos" />
                                <TableColumn fx:id="colDescripcionIntervencion" prefWidth="300.0" text="Descripcion" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 18;">
                        <padding>
                            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                        </padding>

                        <VBox spacing="3.0">
                            <Label text="Bitacora de eventos del alumno"
                                   style="-fx-text-fill: #111827; -fx-font-size: 16px; -fx-font-weight: bold;" />

                            <Label text="Alertas, reportes e intervenciones relacionadas con el alumno seleccionado."
                                   style="-fx-text-fill: #6b7280; -fx-font-size: 12px;" />
                        </VBox>

                        <ListView fx:id="listBitacoraTutor" prefHeight="210.0" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>