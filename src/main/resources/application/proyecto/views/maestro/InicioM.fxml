<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.maestros.InicioMController"
            prefWidth="900.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #e5e8f2;">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Inicio">
            <font>
               <Font name="Arial Black" size="17.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <VBox spacing="18.0" style="-fx-background-color: #e5e8f2;">
         <padding>
            <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
         </padding>


         <VBox spacing="4.0">
            <Label text="Inicio"
                   style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Bienvenido al panel del Maestro"
                   style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
         </VBox>


         <HBox spacing="20.0">
            <HBox HBox.hgrow="ALWAYS" spacing="12.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 15;">
               <padding>
                  <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
               </padding>
               <Label text="📚" style="-fx-font-size: 20px; -fx-background-color: #eaf1fb; -fx-background-radius: 10; -fx-padding: 10;" />
               <VBox spacing="6.0">
                  <Label text="Total de clases">
                     <font><Font name="Arial Black" size="13.0"/></font>
                  </Label>
                  <Label fx:id="lblTotalClases" text="--">
                     <font><Font name="Arial Black" size="24.0"/></font>
                  </Label>
               </VBox>
            </HBox>

            <HBox HBox.hgrow="ALWAYS" spacing="12.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 15;">
               <padding>
                  <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
               </padding>
               <Label text="👥" style="-fx-font-size: 20px; -fx-background-color: #eaf1fb; -fx-background-radius: 10; -fx-padding: 10;" />
               <VBox spacing="6.0">
                  <Label text="Total de alumnos">
                     <font><Font name="Arial Black" size="13.0"/></font>
                  </Label>
                  <Label fx:id="lblTotalAlumnos" text="--">
                     <font><Font name="Arial Black" size="24.0"/></font>
                  </Label>
               </VBox>
            </HBox>

            <HBox HBox.hgrow="ALWAYS" spacing="12.0" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 15;">
               <padding>
                  <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
               </padding>
               <Label text="⚠" style="-fx-font-size: 20px; -fx-text-fill: #c2410c; -fx-background-color: #fff1e8; -fx-background-radius: 10; -fx-padding: 10;" />
               <VBox spacing="6.0">
                  <Label text="Total de alertas">
                     <font><Font name="Arial Black" size="13.0"/></font>
                  </Label>
                  <Label fx:id="lblTotalAlertas" text="--">
                     <font><Font name="Arial Black" size="24.0"/></font>
                  </Label>
               </VBox>
            </HBox>
         </HBox>

         <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox HBox.hgrow="ALWAYS" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 15;">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
               </padding>

               <Label text="Mis Clases">
                  <font><Font name="Arial Black" size="12.0"/></font>
               </Label>

               <TableView fx:id="tablaGrupos" VBox.vgrow="ALWAYS" prefHeight="280.0">
                  <columns>
                     <TableColumn fx:id="colCodigoGrupo" text="Codigo" prefWidth="110.0" />
                     <TableColumn fx:id="colNombreMateriaGrupo" text="Nombre de la materia" prefWidth="250.0" />
                     <TableColumn fx:id="colTotalAlumnosGrupo" text="Total alumnos" prefWidth="130.0" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 15;">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
               </padding>

               <Label text="Alertas activas">
                  <font><Font name="Arial Black" size="12.0"/></font>
               </Label>

               <HBox spacing="10.0" alignment="CENTER_LEFT">
                  <TextField fx:id="txtBuscarAlertas"
                             promptText="Buscar por grupo, materia, alumno o control..."
                             HBox.hgrow="ALWAYS"
                             prefHeight="36.0"
                             style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

                  <ComboBox fx:id="cbFiltroTipoAlerta"
                            prefHeight="36.0"
                            prefWidth="130.0"
                            promptText="Todas" />
               </HBox>

               <TableView fx:id="tablaAlertas" VBox.vgrow="ALWAYS" prefHeight="280.0">
                  <columns>
                     <TableColumn fx:id="colGrupoAlerta" text="Grupo" prefWidth="90.0" />
                     <TableColumn fx:id="colNoControlAlerta" text="No. Control" prefWidth="110.0" />
                     <TableColumn fx:id="colNombreAlerta" text="Nombre" prefWidth="170.0" />
                     <TableColumn fx:id="colMateriaAlerta" text="Materia" prefWidth="140.0" />
                     <TableColumn fx:id="colTipoAlerta" text="Tipo" prefWidth="100.0" />
                  </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
               </TableView>
            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>