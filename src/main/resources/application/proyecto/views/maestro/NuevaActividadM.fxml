<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.maestros.NuevaActividadMController"
            prefWidth="700.0"
            prefHeight="520.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12.0"
              prefHeight="50.0"
              style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
            </padding>

            <Label text="Nueva Actividad">
                <font>
                    <Font name="Arial Black" size="16.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
            <padding>
                <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
            </padding>

            <VBox spacing="4.0">
                <Label text="Registrar nueva actividad"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                <Label text="Agrega una actividad para uno de tus grupos y materias"
                       style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" />
            </VBox>

            <VBox spacing="16.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <HBox spacing="14.0">
                    <VBox spacing="6.0">
                        <Label text="Grupo" style="-fx-text-fill: #6b7280;" />
                        <ComboBox fx:id="cbGrupo"
                                  prefHeight="38.0"
                                  prefWidth="190.0"
                                  promptText="Seleccione grupo" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Turno" style="-fx-text-fill: #6b7280;" />
                        <TextField fx:id="txtTurno"
                                   editable="false"
                                   prefHeight="38.0"
                                   prefWidth="140.0"
                                   promptText="Automatico"
                                   style="-fx-background-color: #f3f4f6; -fx-border-radius: 8;" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Materia" style="-fx-text-fill: #6b7280;" />
                        <ComboBox fx:id="cbMateria"
                                  prefHeight="38.0"
                                  prefWidth="220.0"
                                  promptText="Seleccione materia" />
                    </VBox>
                </HBox>

                <HBox spacing="14.0">
                    <VBox spacing="6.0">
                        <Label text="Nombre de la actividad" style="-fx-text-fill: #6b7280;" />
                        <TextField fx:id="txtNombreActividad"
                                   prefHeight="38.0"
                                   prefWidth="280.0"
                                   promptText="Ej: tarea 1" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Tipo" style="-fx-text-fill: #6b7280;" />
                        <ComboBox fx:id="cbTipoActividad"
                                  prefHeight="38.0"
                                  prefWidth="180.0"
                                  promptText="Tipo" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Fecha" style="-fx-text-fill: #6b7280;" />
                        <DatePicker fx:id="dpFecha"
                                    prefHeight="38.0"
                                    prefWidth="160.0" />
                    </VBox>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Descripcion" style="-fx-text-fill: #6b7280;" />
                    <TextArea fx:id="txtDescripcion"
                              prefHeight="130.0"
                              promptText="Describe la actividad, instrucciones o detalles..."
                              wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="btnCancelar"
                            prefHeight="38.0"
                            prefWidth="120.0"
                            style="-fx-background-color: #e5e7eb; -fx-text-fill: #374151; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="Cancelar" />

                    <Button fx:id="btnGuardarActividad"
                            prefHeight="40.0"
                            prefWidth="180.0"
                            style="-fx-background-color: #0b57d0; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="Guardar actividad" />
                </HBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>