<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.tutores.BitacoraTController"
            prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #e9edf7;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0" style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0" />
         </padding>

         <Label text="Bitacora">
            <font>
               <Font name="Arial Black" size="15.0" />
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS" />

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <VBox spacing="16.0" style="-fx-background-color: #e9edf7;">
         <padding>
            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
         </padding>

         <VBox spacing="2.0">
            <Label text="Bitacora del alumno">
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>

            <Label text="Consulta alertas, reportes e intervenciones registradas para alumnos de tus grupos tutorados"
                   textFill="#6f6f6f">
               <font>
                  <Font name="Arial Italic" size="12.0" />
               </font>
            </Label>
         </VBox>

         <VBox spacing="14.0"
               style="-fx-background-color: white; -fx-background-radius: 16;">
            <padding>
               <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
            </padding>

            <VBox spacing="3.0">
               <Label text="Buscar seguimiento">
                  <font>
                     <Font name="Arial Bold" size="14.0" />
                  </font>
               </Label>

               <Label text="Selecciona un grupo y un alumno para visualizar su historial completo"
                      textFill="#7d7d7d">
                  <font>
                     <Font name="Arial Italic" size="12.0" />
                  </font>
               </Label>
            </VBox>

            <HBox spacing="12.0">
               <ComboBox fx:id="cbGrupoBitacora"
                         prefHeight="38.0"
                         prefWidth="220.0"
                         promptText="Seleccionar grupo..." />

               <ComboBox fx:id="cbAlumnoBitacora"
                         prefHeight="38.0"
                         prefWidth="360.0"
                         promptText="Seleccionar alumno..." />

               <Button fx:id="btnBuscarAlumnoBitacora"
                       mnemonicParsing="false"
                       onAction="#handleBuscarAlumno"
                       prefHeight="38.0"
                       prefWidth="120.0"
                       style="-fx-background-color: #7259e8; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                       text="Buscar">
                  <font>
                     <Font name="Arial Bold" size="12.0" />
                  </font>
               </Button>

               <Region HBox.hgrow="ALWAYS" />
            </HBox>
         </VBox>

         <VBox spacing="14.0"
               style="-fx-background-color: white; -fx-background-radius: 16;"
               VBox.vgrow="ALWAYS">
            <padding>
               <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                  <image>
                     <Image url="@../../fotos/IconoBitacora.png" />
                  </image>
               </ImageView>

               <VBox spacing="2.0">
                  <Label text="Historial completo del alumno">
                     <font>
                        <Font name="Arial Bold" size="14.0" />
                     </font>
                  </Label>

                  <Label text="Eventos ordenados por fecha: alertas, reportes e intervenciones"
                         textFill="#7d7d7d">
                     <font>
                        <Font name="Arial Italic" size="12.0" />
                     </font>
                  </Label>
               </VBox>
            </HBox>

            <Separator />

            <ListView fx:id="listBitacoraAlumno"
                      prefHeight="360.0"
                      VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER">
               <Label fx:id="lblMensajeBitacora"
                      text="Selecciona un alumno para visualizar su seguimiento"
                      textFill="#7f7f8f">
                  <font>
                     <Font size="12.0" />
                  </font>
               </Label>
            </HBox>
         </VBox>
      </VBox>
   </center>
</BorderPane>