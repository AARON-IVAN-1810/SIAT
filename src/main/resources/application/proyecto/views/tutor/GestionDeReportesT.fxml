<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.tutores.GestionDeReportesTController"
            prefHeight="650.0"
            prefWidth="1100.0"
            style="-fx-background-color: #e9edf7;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0" />
            </padding>

            <Label text="Gestion de Reportes">
                <font>
                    <Font name="Arial Black" size="15.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                    <image>
                        <Image url="@../../fotos/IconoSalir.png" />
                    </image>
                </ImageView>

                <Button text="Cerrar Sesion"
                        onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <font>
                        <Font name="Arial Black" size="12.0" />
                    </font>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="16.0" style="-fx-background-color: #e9edf7;">
            <padding>
                <Insets top="16.0" right="0.0" bottom="16.0" left="16.0" />
            </padding>



            <VBox spacing="4.0">
                <Label text="Gestion de Reportes"
                       style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                <Label text="Consulta y seguimiento de reportes generados en los grupos tutorados"
                       style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
            </VBox>


            <VBox spacing="14.0"
                  style="-fx-background-color: white; -fx-background-radius: 16;"
                  VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
                </padding>

                <VBox spacing="3.0">
                    <Label text="Reportes de grupos tutorados">
                        <font>
                            <Font name="Arial Bold" size="14.0" />
                        </font>
                    </Label>

                    <Label text="Selecciona un reporte para ver la informacion completa del alumno"
                           textFill="#7d7d7d">
                        <font>
                            <Font name="Arial Italic" size="12.0" />
                        </font>
                    </Label>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ComboBox fx:id="cmbGrupoFiltro"
                              prefHeight="36.0"
                              prefWidth="130.0"
                              promptText="Grupo" />

                    <ComboBox fx:id="cmbTipoFiltro"
                              prefHeight="36.0"
                              prefWidth="150.0"
                              promptText="Tipo de reporte" />

                    <ComboBox fx:id="cmbEstatusFiltro"
                              prefHeight="36.0"
                              prefWidth="130.0"
                              promptText="Estatus" />

                    <HBox alignment="CENTER_LEFT"
                          spacing="8.0"
                          style="-fx-background-color: white; -fx-border-color: #d9dce5; -fx-border-radius: 8; -fx-background-radius: 8;"
                          HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="0.0" right="10.0" bottom="0.0" left="10.0" />
                        </padding>

                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                            <image>
                                <Image url="@../../fotos/IconoLupa.png" />
                            </image>
                        </ImageView>

                        <TextField fx:id="txtBuscarTabla"
                                   promptText="Buscar por alumno, no. control, materia, maestro o fecha..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                   HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </TextField>
                    </HBox>
                </HBox>

                <TableView fx:id="tablaGestionReportesTutor"
                           prefHeight="430.0"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAlumno" prefWidth="210.0" text="Alumno" />
                        <TableColumn fx:id="colGrupo" prefWidth="90.0" text="Grupo" />
                        <TableColumn fx:id="colMateria" prefWidth="150.0" text="Materia" />
                        <TableColumn fx:id="colTipoReporte" prefWidth="130.0" text="Tipo de reporte" />
                        <TableColumn fx:id="colMaestro" prefWidth="160.0" text="Maestro" />
                        <TableColumn fx:id="colEstatus" prefWidth="110.0" text="Estatus" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="360.0" spacing="14.0" style="-fx-background-color: white;">
            <padding>
                <Insets top="84.0" right="16.0" bottom="16.0" left="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true">
                    <image>
                        <Image url="@../../fotos/PerfilAlumno.png" />
                    </image>
                </ImageView>

                <VBox spacing="2.0">
                    <Label fx:id="lblNombreAlumno" text="Selecciona un reporte" textFill="#8a8a99">
                        <font>
                            <Font name="Arial Black" size="17.0" />
                        </font>
                    </Label>

                    <Label text="Detalle del alumno y el reporte" textFill="#a0a0ad">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>
            </HBox>

            <Separator />

            <VBox spacing="12.0">
                <HBox spacing="6.0">
                    <Label text="Numero de control:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblNumeroControl" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Grupo:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblGrupo" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Semestre:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblSemestre" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Turno:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblTurno" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Materia:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblMateria" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Maestro:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblMaestro" text="---" textFill="#9b9baa" wrapText="true" />
                </HBox>
            </VBox>

            <Separator />

            <VBox spacing="12.0">
                <HBox spacing="6.0">
                    <Label text="Tipo de reporte:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblTipoReporte" text="Sin seleccionar" textFill="#9b9baa" />
                </HBox>

                <VBox spacing="4.0">
                    <Label text="Descripcion:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblDescripcion"
                           text="Selecciona un reporte para mostrar la descripcion."
                           textFill="#9b9baa"
                           wrapText="true" />
                </VBox>

                <HBox spacing="6.0">
                    <Label text="Fecha:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblFechaCreacion" text="---" textFill="#9b9baa" />
                </HBox>

                <HBox spacing="6.0">
                    <Label text="Estatus:" textFill="#5d5d5d">
                        <font><Font name="Arial Bold" size="12.0" /></font>
                    </Label>
                    <Label fx:id="lblEstatusDetalle" text="---" textFill="#9b9baa" />
                </HBox>
            </VBox>

            <Separator />

            <VBox spacing="10.0">
                <Button fx:id="btnDarSeguimiento"
                        onAction="#handleDarSeguimiento"
                        prefHeight="40.0"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: #7259e8; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Dar seguimiento">
                    <font><Font name="Arial Bold" size="13.0" /></font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </right>
</BorderPane>