<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.MaestrosJDMController"
            prefWidth="900.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

   <top>
      <HBox alignment="CENTER_LEFT"
            spacing="12.0"
            prefHeight="50.0"
            style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Maestros">
            <font>
               <Font name="Arial Black" size="17.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>


         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>



   </top>

   <center>
      <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
         <padding>
            <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
         </padding>

         <VBox spacing="4.0">
            <Label text="Maestros"
                   style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Gestion de personal docente"
                   style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
         </VBox>

         <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox prefWidth="300.0"
                  spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="18.0" right="16.0" bottom="16.0" left="16.0"/>
               </padding>

               <Label text="Agregar Maestro"
                      style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <TextField fx:id="txtNombreMaestro"
                          promptText="Nombre"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtApellidoPaternoMaestro"
                          promptText="Apellido paterno"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtApellidoMaternoMaestro"
                          promptText="Apellido materno"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtNumeroEmpleado"
                          promptText="No. de empleado"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtCorreoInstitucional"
                          promptText="Correo institucional"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtTelefonoInstitucional"
                          promptText="Telefono institucional"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <Button text="Guardar"
                       onAction="#handleGuardarMaestro"
                       prefHeight="40.0"
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

               <HBox spacing="8.0">
                  <Button text="Editar"
                          onAction="#handleEditarMaestro"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: linear-gradient(to right, #6f7bc7, #5f6ebb); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;" />

                  <Button text="Activar/Desactivar"
                          onAction="#handleCambiarEstatusMaestro"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: linear-gradient(to right, #7762d9, #6956cc); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;" />
               </HBox>

               <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="10.0"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: transparent;">

               <Label text="Lista de Maestros"
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <VBox VBox.vgrow="ALWAYS"
                     spacing="12.0"
                     style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                  <padding>
                     <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>

                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <HBox alignment="CENTER_LEFT"
                           spacing="8.0"
                           style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;"
                           HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets top="0.0" right="12.0" bottom="0.0" left="12.0"/>
                        </padding>

                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                           <image>
                              <Image url="@../../fotos/IconoLupa.png" />
                           </image>
                        </ImageView>

                        <TextField fx:id="txtBuscarMaestroInterno"
                                   promptText="Buscar maestro, empleado, correo o telefono..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                     </HBox>

                     <ComboBox fx:id="cbFiltroMaestros"
                               prefHeight="38.0"
                               prefWidth="130.0"
                               promptText="Todos" />
                  </HBox>

                  <TableView fx:id="tablaMaestros"
                             VBox.vgrow="ALWAYS"
                             prefHeight="420.0">
                     <columns>
                        <TableColumn fx:id="colNombreMaestro" text="Nombre" prefWidth="220.0" />
                        <TableColumn fx:id="colNumeroEmpleadoMaestro" text="No. empleado" prefWidth="130.0" />
                        <TableColumn fx:id="colCorreoMaestro" text="Correo" prefWidth="220.0" />
                        <TableColumn fx:id="colTelefonoMaestro" text="Telefono" prefWidth="130.0" />
                        <TableColumn fx:id="colEstatusMaestro" text="Estatus" prefWidth="100.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </VBox>
            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>