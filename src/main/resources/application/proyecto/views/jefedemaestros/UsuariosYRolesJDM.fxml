<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.UsuariosYRolesJDMController"
            prefWidth="900.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Usuarios y roles">
            <font>
               <Font name="Arial Black" size="17.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>


         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>



   </top>

   <center>
      <VBox spacing="16.0" style="-fx-background-color: #f4f6fb;">
         <padding>
            <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
         </padding>

         <VBox spacing="4.0">
            <Label text="Usuarios y roles"
                   style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Control de acceso de maestros al sistema"
                   style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
         </VBox>

         <HBox spacing="14.0">
            <VBox HBox.hgrow="ALWAYS"
                  spacing="4.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
               </padding>
               <Label text="Usuarios activos" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
               <Label fx:id="lblUsuariosActivos" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            </VBox>

            <VBox HBox.hgrow="ALWAYS"
                  spacing="4.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
               </padding>
               <Label text="Pendientes de contrasena" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
               <Label fx:id="lblPendientesContrasena" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            </VBox>

            <VBox HBox.hgrow="ALWAYS"
                  spacing="4.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
               </padding>
               <Label text="Maestros tutores" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
               <Label fx:id="lblMaestrosTutores" text="0" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            </VBox>
         </HBox>

         <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox prefWidth="310.0"
                  spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="18.0" right="16.0" bottom="16.0" left="16.0"/>
               </padding>

               <Label text="Asignar acceso"
                      style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <ComboBox fx:id="cbMaestroUsuario"
                         prefHeight="38.0"
                         maxWidth="1.7976931348623157E308"
                         promptText="Seleccionar maestro..."
                         style="-fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtNombreMaestro"
                          promptText="Maestro"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtNumeroEmpleado"
                          promptText="Numero de empleado"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtUsuario"
                          promptText="Usuario generado"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <VBox spacing="8.0"
                     style="-fx-background-color: white; -fx-border-color: #d9dde8; -fx-border-radius: 10; -fx-background-radius: 10;">
                  <padding>
                     <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>

                  <Label text="Roles del sistema"
                         style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

                  <CheckBox fx:id="chkRolMaestro" text="Maestro" />
                  <CheckBox fx:id="chkRolTutor" text="Tutor" />
                  <CheckBox fx:id="chkRolJefeMaestros" text="Jefe de maestros" />
               </VBox>

               <Button text="Guardar acceso"
                       onAction="#handleGuardarUsuario"
                       prefHeight="40.0"
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

               <Button text="Activar/Desactivar"
                       onAction="#handleCambiarEstatusUsuario"
                       prefHeight="38.0"
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: linear-gradient(to right, #7762d9, #6956cc); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;" />

               <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="10.0"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: transparent;">

               <Label text="Lista de accesos"
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <VBox VBox.vgrow="ALWAYS"
                     spacing="12.0"
                     style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                  <padding>
                     <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>

                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <HBox alignment="CENTER_LEFT"
                           spacing="8.0"
                           style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;"
                           HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets top="0.0" right="12.0" bottom="0.0" left="12.0"/>
                        </padding>

                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                           <image>
                              <Image url="@../../fotos/IconoLupa.png" />
                           </image>
                        </ImageView>

                        <TextField fx:id="txtBuscarUsuarioInterno"
                                   promptText="Buscar maestro, numero de empleado, rol o acceso..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                     </HBox>

                     <ComboBox fx:id="cbFiltroUsuarios"
                               prefHeight="38.0"
                               prefWidth="130.0"
                               promptText="Todos" />
                  </HBox>

                  <TableView fx:id="tablaUsuarios"
                             VBox.vgrow="ALWAYS"
                             prefHeight="360.0">
                     <columns>
                        <TableColumn fx:id="colMaestroRelacionado" text="Maestro" prefWidth="210.0" />
                        <TableColumn fx:id="colNumeroEmpleadoUsuario" text="No. empleado" prefWidth="130.0" />
                        <TableColumn fx:id="colRolesUsuario" text="Roles" prefWidth="180.0" />
                        <TableColumn fx:id="colAccesoUsuario" text="Acceso" prefWidth="160.0" />
                        <TableColumn fx:id="colEstatusUsuario" text="Estatus" prefWidth="100.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </VBox>
            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>