<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="900.0"
            style="-fx-background-color: #f4f6fb;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.proyecto.controllers.jefedemaestros.GruposJDMController">

   <top>
      <HBox alignment="CENTER_LEFT"
            prefHeight="50.0"
            spacing="12.0"
            style="-fx-background-color: #ffffff;">
         <padding>
            <Insets bottom="8.0" left="14.0" right="14.0" top="8.0" />
         </padding>

         <Label text="Grupos">
            <font>
               <Font name="Arial Black" size="17.0" />
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS" />

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;"
                    text="Cerrar Sesion">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
         </padding>

         <VBox spacing="4.0">
            <Label text="Grupos"
                   style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

            <Label text="Gestion de grupos administrativos por semestre, turno y ciclo escolar"
                   style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
         </VBox>

         <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox prefWidth="310.0"
                  spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="18.0" />
               </padding>

               <Label text="Agregar Grupo"
                      style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <TextField fx:id="txtNombreGrupo"
                          prefHeight="38.0"
                          promptText="Nombre ej. 4a"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

               <TextField fx:id="txtClaveGrupo"
                          prefHeight="38.0"
                          promptText="Clave ej. isc-4a-m"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8;" />

               <ComboBox fx:id="cbTurnoGrupo"
                         maxWidth="1.7976931348623157E308"
                         prefHeight="38.0"
                         promptText="Turno" />

               <ComboBox fx:id="cbSemestreGrupo"
                         maxWidth="1.7976931348623157E308"
                         prefHeight="38.0"
                         promptText="Semestre" />

               <ComboBox fx:id="cbCicloGrupo"
                         maxWidth="1.7976931348623157E308"
                         prefHeight="38.0"
                         promptText="Ciclo escolar" />

               <ComboBox fx:id="cbTutorGrupo"
                         maxWidth="1.7976931348623157E308"
                         prefHeight="38.0"
                         promptText="Maestro tutor" />

               <VBox spacing="8.0"
                     style="-fx-background-color: white; -fx-border-color: #d9dde8; -fx-border-radius: 10;">
                  <padding>
                     <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                  </padding>

                  <Label text="Clases asociadas al grupo"
                         style="-fx-font-size: 13px; -fx-font-weight: bold;" />

                  <Label text="Las clases se crean desde la vista de materias"
                         wrapText="true"
                         style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />

                  <ListView fx:id="listViewMateriasGrupo"
                            prefHeight="160.0" />
               </VBox>

               <Button text="Guardar"
                       onAction="#handleGuardarGrupo"
                       maxWidth="1.7976931348623157E308"
                       prefHeight="40.0"
                       style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

               <HBox spacing="8.0">
                  <Button text="Editar"
                          onAction="#handleEditarGrupo"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: #6574c4; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />

                  <Button text="Cerrar/Abrir"
                          onAction="#handleCambiarEstatusGrupo"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: #6956cc; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" />
               </HBox>

               <Region VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <Label text="Lista de Grupos"
                      style="-fx-font-size: 18px; -fx-font-weight: bold;" />

               <VBox spacing="12.0"
                     VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                  <padding>
                     <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                  </padding>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <HBox alignment="CENTER_LEFT"
                           spacing="8.0"
                           style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;"
                           HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets top="0.0" right="12.0" bottom="0.0" left="12.0"/>
                        </padding>

                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                           <image>
                              <Image url="@../../fotos/IconoLupa.png" />
                           </image>
                        </ImageView>

                        <TextField fx:id="txtBuscarGrupoInterno"
                                   prefHeight="38.0"
                                   promptText="Buscar grupo, clave, turno, ciclo o clase..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                   HBox.hgrow="ALWAYS" />
                     </HBox>

                     <ComboBox fx:id="cbFiltroGrupos"
                               prefHeight="38.0"
                               prefWidth="130.0"
                               promptText="Todos" />
                  </HBox>

                  <TableView fx:id="tablaGrupos"
                             prefHeight="420.0"
                             VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colNombreGrupo" prefWidth="90.0" text="Grupo" />
                        <TableColumn fx:id="colClaveGrupo" prefWidth="120.0" text="Clave" />
                        <TableColumn fx:id="colTurnoGrupo" prefWidth="100.0" text="Turno" />
                        <TableColumn fx:id="colSemestreGrupo" prefWidth="85.0" text="Semestre" />
                        <TableColumn fx:id="colCicloGrupo" prefWidth="110.0" text="Ciclo" />
                        <TableColumn fx:id="colTutorGrupo" prefWidth="160.0" text="Tutor" />
                        <TableColumn fx:id="colMateriasGrupo" prefWidth="230.0" text="Clases" />
                        <TableColumn fx:id="colEstatusGrupo" prefWidth="90.0" text="Estatus" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </VBox>
            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>