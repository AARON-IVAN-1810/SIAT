<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.HistorialAlumnoJDMController"
            prefWidth="900.0"
            prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
            <padding>
                <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
            </padding>

            <Label text="Historial del alumno">
                <font>
                    <Font name="Arial Black" size="17.0"/>
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_LEFT" spacing="6.0">
                <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
                    <image>
                        <Image url="@../../fotos/IconoSalir.png"/>
                    </image>
                </ImageView>

                <Button text="Cerrar Sesion"
                        onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <font>
                        <Font name="Arial Black" size="12.0"/>
                    </font>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #f4f6fb; -fx-background-color: #f4f6fb;">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                    </padding>

                    <VBox spacing="4.0">
                        <Label text="Historial del alumno"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <Label text="Consulta alertas, reportes, diagnostico automatico y posibles causas de seguimiento"
                               style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
                    </VBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                        <padding>
                            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                        </padding>

                        <Label text="Seleccionar alumno"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <HBox alignment="CENTER_LEFT" spacing="12.0">

                            <ComboBox fx:id="cbGrupo"
                                      prefHeight="40.0"
                                      prefWidth="220.0"
                                      promptText="Seleccione Clase" />

                            <ComboBox fx:id="cbAlumno"
                                      prefHeight="40.0"
                                      prefWidth="420.0"
                                      promptText="Seleccione alumno" />

                            <Button fx:id="btnCargarHistorial"
                                    text="Cargar historial"
                                    onAction="#cargarHistorial"
                                    prefHeight="40.0"
                                    prefWidth="160.0"
                                    style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>

                    <HBox spacing="14.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>
                            <Label text="Total alertas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Label fx:id="lblTotalAlertas" text="0"
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>
                            <Label text="Alertas asistencia" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Label fx:id="lblAlertasAsistencia" text="0"
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>
                            <Label text="Alertas actividad" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Label fx:id="lblAlertasActividad" text="0"
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>
                            <Label text="Reportes generados" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Label fx:id="lblReportesGenerados" text="0"
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>
                            <Label text="Estado actual" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                            <Label fx:id="lblEstadoActual" text="--"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>
                    </HBox>

                    <VBox spacing="12.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                        <padding>
                            <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                        </padding>

                        <Label text="Diagnostico del historial"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <VBox spacing="8.0"
                              style="-fx-background-color: #f9fafb; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                            </padding>

                            <Label fx:id="lblDiagnostico"
                                   text="Selecciona un alumno para generar el diagnostico del historial."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;" />

                            <Label fx:id="lblCausasDetectadas"
                                   text="Sin causas detectadas."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;" />

                            <Label fx:id="lblRecomendacion"
                                   text="Sin recomendacion disponible."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                        </VBox>
                    </VBox>

                    <HBox spacing="18.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>

                            <Label text="Alertas del alumno"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                            <TableView fx:id="tablaAlertas" prefHeight="260.0">
                                <columns>
                                    <TableColumn fx:id="colFechaAlerta" text="Fecha" prefWidth="90.0" />
                                    <TableColumn fx:id="colGrupoAlerta" text="Grupo" prefWidth="90.0" />
                                    <TableColumn fx:id="colMateriaAlerta" text="Materia" prefWidth="150.0" />
                                    <TableColumn fx:id="colMotivoAlerta" text="Motivo" prefWidth="100.0" />
                                    <TableColumn fx:id="colEstadoAlerta" text="Estado" prefWidth="110.0" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e7eb;">
                            <padding>
                                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                            </padding>

                            <Label text="Reportes generados"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                            <TableView fx:id="tablaReportes" prefHeight="260.0">
                                <columns>
                                    <TableColumn fx:id="colFechaReporte" text="Fecha" prefWidth="90.0" />
                                    <TableColumn fx:id="colGrupoReporte" text="Grupo" prefWidth="90.0" />
                                    <TableColumn fx:id="colMateriaReporte" text="Materia" prefWidth="130.0" />
                                    <TableColumn fx:id="colMotivoReporte" text="Motivo" prefWidth="100.0" />
                                    <TableColumn fx:id="colDescripcionReporte" text="Descripcion" prefWidth="250.0" />
                                    <TableColumn fx:id="colEstadoReporte" text="Estado" prefWidth="100.0" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>