<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.EstadisticasJDMController"
            prefWidth="900.0"
            prefHeight="700.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="50.0" style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Estadisticas">
            <font>
               <Font name="Arial Black" size="17.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true"
                  hbarPolicy="NEVER"
                  vbarPolicy="AS_NEEDED"
                  style="-fx-background: #f4f6fb; -fx-background-color: #f4f6fb;">
         <content>
            <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
               <padding>
                  <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
               </padding>

               <VBox spacing="4.0">
                  <Label text="Estadisticas inteligentes"
                         style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                  <Label text="Analisis automatico de alertas, grupos, materias, maestros y comportamiento por sexo"
                         style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
               </VBox>

               <HBox spacing="14.0">
                  <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Total alertas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     <Label fx:id="lblTotalAlertas" text="0"
                            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label text="Activas y en seguimiento" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Por asistencia" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     <Label fx:id="lblAlertasAsistencia" text="0"
                            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label text="Faltas acumuladas" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Por actividades" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     <Label fx:id="lblAlertasActividad" text="0"
                            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label text="Entregas pendientes" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Hombres con alertas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     <Label fx:id="lblPorcentajeHombres" text="0%"
                            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label text="Porcentaje del total" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="6.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Mujeres con alertas" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     <Label fx:id="lblPorcentajeMujeres" text="0%"
                            style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label text="Porcentaje del total" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
                  </VBox>
               </HBox>

               <VBox spacing="12.0"
                     style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                  <padding>
                     <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                  </padding>

                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Semaforo institucional"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <Label text="Diagnostico automatico generado con base en las alertas activas"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />
                     </VBox>

                     <Button text="Actualizar estadisticas"
                             onAction="#handleActualizarEstadisticas"
                             prefHeight="38.0"
                             style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                  </HBox>

                  <HBox spacing="14.0" alignment="CENTER_LEFT">
                     <VBox minWidth="190.0"
                           prefWidth="190.0"
                           maxWidth="190.0"
                           spacing="8.0"
                           style="-fx-background-color: #eef3fb; -fx-background-radius: 14; -fx-border-radius: 14;">
                        <padding>
                           <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                        </padding>

                        <Label text="Riesgo general"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" />

                        <Label fx:id="lblRiesgoGeneral"
                               text="--"
                               wrapText="true"
                               minWidth="150.0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     </VBox>

                     <VBox spacing="8.0" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #f9fafb; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                        <padding>
                           <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                        </padding>

                        <Label text="Diagnostico automatico"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                        <Label fx:id="lblDiagnosticoAutomatico"
                               text="Sin datos suficientes para generar diagnostico."
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                     </VBox>
                  </HBox>

                  <VBox spacing="8.0"
                        style="-fx-background-color: #f9fafb; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                     <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                     </padding>
                     <Label text="Recomendacion del sistema"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                     <Label fx:id="lblRecomendacionAutomatica"
                            text="Sin recomendacion disponible."
                            wrapText="true"
                            style="-fx-font-size: 13px; -fx-text-fill: #374151;" />
                  </VBox>
               </VBox>

               <HBox spacing="18.0">
                  <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                     <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                     </padding>

                     <Label text="Grupos con mas alertas"
                            style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                     <TableView fx:id="tablaRankingGrupos" prefHeight="230.0">
                        <columns>
                           <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="180.0" />
                           <TableColumn fx:id="colAlertasGrupo" text="Alertas" prefWidth="90.0" />
                           <TableColumn fx:id="colPorcentajeGrupo" text="Porcentaje" prefWidth="80.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                     <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                     </padding>

                     <Label text="Materias con mas alertas"
                            style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                     <TableView fx:id="tablaRankingMaterias" prefHeight="230.0">
                        <columns>
                           <TableColumn fx:id="colMateria" text="Materia" prefWidth="180.0" />
                           <TableColumn fx:id="colAlertasMateria" text="Alertas" prefWidth="90.0" />
                           <TableColumn fx:id="colPorcentajeMateria" text="Porcentaje" prefWidth="80.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </VBox>

                  <VBox HBox.hgrow="ALWAYS" spacing="12.0"
                        style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                     <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                     </padding>

                     <Label text="Maestros con mas alertas"
                            style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

                     <TableView fx:id="tablaRankingMaestros" prefHeight="230.0">
                        <columns>
                           <TableColumn fx:id="colMaestro" text="Maestro" prefWidth="180.0" />
                           <TableColumn fx:id="colAlertasMaestro" text="Alertas" prefWidth="90.0" />
                           <TableColumn fx:id="colPorcentajeMaestro" text="Porcentaje" prefWidth="80.0" />
                        </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                     </TableView>
                  </VBox>
               </HBox>

            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>