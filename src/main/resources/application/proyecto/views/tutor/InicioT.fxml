<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.tutores.InicioTController" prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #e9edf7;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0" style="-fx-background-color: white;">
         <padding>
            <Insets top="8.0" right="16.0" bottom="8.0" left="16.0" />
         </padding>

         <Label text="Inicio">
            <font>
               <Font name="Arial Black" size="15.0" />
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS" />

         <HBox alignment="CENTER_LEFT" prefHeight="34.0" spacing="6.0" style="-fx-background-color: #eef3fb; -fx-background-radius: 9;">
            <padding>
               <Insets top="0.0" right="10.0" bottom="0.0" left="10.0" />
            </padding>

            <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoLupa.png" />
               </image>
            </ImageView>

            <TextField prefWidth="185.0" promptText="Buscar alumno, grupo..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;">
               <font>
                  <Font size="12.0" />
               </font>
            </TextField>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

           <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0" />
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <center>
      <VBox spacing="16.0" style="-fx-background-color: #e9edf7;">
         <padding>
            <Insets top="18.0" right="16.0" bottom="16.0" left="16.0" />
         </padding>

         <!-- encabezado -->
         <VBox spacing="2.0">
            <Label text="Panel Principal del Tutor">
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>

            <Label text="Seguimiento de alertas e intervenciones" textFill="#7a7a7a">
               <font>
                  <Font name="Arial Italic" size="12.0" />
               </font>
            </Label>
         </VBox>

         <!-- tarjetas resumen -->
         <HBox spacing="14.0">

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
               </padding>

               <Label text="Alertas Activas" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>

               <Label fx:id="lblAlertasActivas" text="--" textFill="#3c3c4d">
                  <font>
                     <Font name="Arial Bold" size="24.0" />
                  </font>
               </Label>

               <Label text="Requieren atencion" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
               </padding>

               <Label text="Casos en Seguimiento" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>

               <Label fx:id="lblCasosSeguimiento" text="--" textFill="#3c3c4d">
                  <font>
                     <Font name="Arial Bold" size="24.0" />
                  </font>
               </Label>

               <Label text="En proceso activo" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
               </padding>

               <Label text="Casos Cerrados" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>

               <Label fx:id="lblCasosCerrados" text="--" textFill="#3c3c4d">
                  <font>
                     <Font name="Arial Bold" size="24.0" />
                  </font>
               </Label>

               <Label text="Resueltos exitosamente" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets top="16.0" right="16.0" bottom="16.0" left="16.0" />
               </padding>

               <Label text="Intervenciones Recientes" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>

               <Label fx:id="lblIntervencionesRecientes" text="--" textFill="#3c3c4d">
                  <font>
                     <Font name="Arial Bold" size="24.0" />
                  </font>
               </Label>

               <Label text="Ultimos 30 dias" textFill="#8d8d8d">
                  <font>
                     <Font size="11.0" />
                  </font>
               </Label>
            </VBox>
         </HBox>

         <!-- tarjeta principal -->
         <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 16;" VBox.vgrow="ALWAYS">
            <padding>
               <Insets top="14.0" right="14.0" bottom="14.0" left="14.0" />
            </padding>

            <VBox spacing="3.0">
               <Label text="Alertas Pendientes">
                  <font>
                     <Font name="Arial Bold" size="13.0" />
                  </font>
               </Label>

               <Label text="Alumnos que exigen intervenciones" textFill="#7d7d7d">
                  <font>
                     <Font name="Arial Italic" size="12.0" />
                  </font>
               </Label>
            </VBox>

            <!-- filtros -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <ComboBox fx:id="cmbGrupoFiltro" prefHeight="34.0" prefWidth="110.0" promptText="Grupo" style="-fx-background-radius: 8; -fx-border-radius: 8;" />
               <ComboBox fx:id="cmbPrioridadFiltro" prefHeight="34.0" prefWidth="110.0" promptText="Prioridad" style="-fx-background-radius: 8; -fx-border-radius: 8;" />

               <Button fx:id="btnBuscar" mnemonicParsing="false" prefHeight="34.0" prefWidth="78.0" style="-fx-background-color: #6d5be3; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand;" text="Buscar">
                  <font>
                     <Font name="Arial Bold" size="12.0" />
                  </font>
               </Button>

               <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #d9dce5; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets top="0.0" right="10.0" bottom="0.0" left="10.0" />
                  </padding>

                  <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                     <image>
                        <Image url="@../../fotos/IconoLupa.png" />
                     </image>
                  </ImageView>

                  <TextField fx:id="txtBuscarTabla" promptText="Buscar alumno o tipo de alerta..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </TextField>
               </HBox>
            </HBox>

            <!-- tabla -->
            <TableView fx:id="tablaAlertasTutor" prefHeight="320.0" style="-fx-background-radius: 10;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colAlumno" prefWidth="210.0" text="Alumno" />
                  <TableColumn fx:id="colGrupo" prefWidth="100.0" text="Grupo" />
                  <TableColumn fx:id="colTipoAlerta" prefWidth="180.0" text="Tipo de alerta" />
                  <TableColumn fx:id="colPrioridad" prefWidth="100.0" text="Prioridad" />
                  <TableColumn fx:id="colEstatus" prefWidth="110.0" text="Estatus" />
                  <TableColumn fx:id="colAccion" prefWidth="120.0" text="Accion" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </VBox>
      </VBox>
   </center>
</BorderPane>