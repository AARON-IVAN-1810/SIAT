<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="application.proyecto.controllers.jefedemaestros.UsuariosYRolesJDMController"
            prefWidth="900.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            style="-fx-background-color: #f4f6fb;">

   <!-- barra superior -->
   <top>
      <HBox alignment="CENTER_LEFT"
            spacing="12.0"
            prefHeight="50.0"
            style="-fx-background-color: #ffffff;">
         <padding>
            <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
         </padding>

         <Label text="Usuarios y roles">
            <font>
               <Font name="Arial Black" size="17.0"/>
            </font>
         </Label>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox alignment="CENTER_LEFT"
               spacing="6.0"
               style="-fx-background-color: #eaf1fb; -fx-background-radius: 8;"
               prefHeight="32.0">
            <padding>
               <Insets left="8.0" right="8.0"/>
            </padding>

            <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoLupa.png" />
               </image>
            </ImageView>

            <TextField promptText="Buscar usuario, rol..."
                       prefWidth="190.0"
                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;">
               <font>
                  <Font size="13.0"/>
               </font>
            </TextField>
         </HBox>

         <HBox alignment="CENTER_LEFT" spacing="6.0">
            <ImageView fitHeight="22.0" fitWidth="22.0" preserveRatio="true">
               <image>
                  <Image url="@../../fotos/IconoSalir.png" />
               </image>
            </ImageView>

            <Button text="Cerrar Sesion"
                    onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-cursor: hand;">
               <font>
                  <Font name="Arial Black" size="12.0"/>
               </font>
            </Button>
         </HBox>
      </HBox>
   </top>

   <!-- contenido -->
   <center>
      <VBox spacing="18.0" style="-fx-background-color: #f4f6fb;">
         <padding>
            <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
         </padding>

         <!-- titulo -->
         <VBox spacing="4.0">
            <Label text="Usuarios y roles"
                   style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Label text="Administracion de cuentas"
                   style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
         </VBox>

         <!-- contenido principal -->
         <HBox spacing="20.0" VBox.vgrow="ALWAYS">

            <!-- panel izquierdo -->
            <VBox prefWidth="300.0"
                  spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
               <padding>
                  <Insets top="18.0" right="16.0" bottom="16.0" left="16.0"/>
               </padding>

               <Label text="Agregar Usuario"
                      style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <ComboBox fx:id="cbMaestroUsuario"
                         prefHeight="38.0"
                         promptText="Seleccionar maestro..."
                         style="-fx-background-radius: 8; -fx-border-radius: 8;" />

               <TextField fx:id="txtUsuario"
                          promptText="Usuario"
                          prefHeight="38.0"
                          style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <PasswordField fx:id="txtContrasena"
                              promptText="Contraseña"
                              prefHeight="38.0"
                              style="-fx-background-color: #eef3fb; -fx-background-radius: 8; -fx-border-radius: 8;" />

               <VBox spacing="8.0"
                     style="-fx-background-color: white; -fx-border-color: #d9dde8; -fx-border-radius: 10; -fx-background-radius: 10;">
                  <padding>
                     <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>

                  <Label text="Roles"
                         style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;" />

                  <CheckBox fx:id="chkRolMaestro" text="Maestro" />
                  <CheckBox fx:id="chkRolTutor" text="Tutor" />
                  <CheckBox fx:id="chkRolAdministrador" text="Administrador" />
               </VBox>

               <Button text="Guardar"
                       prefHeight="40.0"
                       maxWidth="1.7976931348623157E308"
                       style="-fx-background-color: #1d5bd6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

               <HBox spacing="8.0">
                  <Button text="Editar"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: linear-gradient(to right, #6f7bc7, #5f6ebb); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;" />

                  <Button text="Activar/Desactivar"
                          HBox.hgrow="ALWAYS"
                          maxWidth="1.7976931348623157E308"
                          prefHeight="38.0"
                          style="-fx-background-color: linear-gradient(to right, #7762d9, #6956cc); -fx-text-fill: white; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;" />
               </HBox>

               <Region VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- panel derecho -->
            <VBox spacing="10.0"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: transparent;">

               <Label text="Lista de Usuarios"
                      style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

               <VBox VBox.vgrow="ALWAYS"
                     spacing="12.0"
                     style="-fx-background-color: white; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #e5e7eb;">
                  <padding>
                     <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                  </padding>

                  <!-- barra superior -->
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <HBox alignment="CENTER_LEFT"
                           spacing="8.0"
                           style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;"
                           HBox.hgrow="ALWAYS">
                        <padding>
                           <Insets top="0.0" right="12.0" bottom="0.0" left="12.0"/>
                        </padding>

                        <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                           <image>
                              <Image url="@../../fotos/IconoLupa.png" />
                           </image>
                        </ImageView>

                        <TextField fx:id="txtBuscarUsuarioInterno"
                                   promptText="Buscar usuario, maestro o rol..."
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"
                                   HBox.hgrow="ALWAYS"/>
                     </HBox>

                     <ComboBox fx:id="cbFiltroUsuarios"
                               prefHeight="38.0"
                               prefWidth="130.0"
                               promptText="Todos" />
                  </HBox>

                  <!-- tabla unica -->
                  <TableView fx:id="tablaUsuarios"
                             VBox.vgrow="ALWAYS"
                             prefHeight="420.0">
                     <columns>
                        <TableColumn fx:id="colIdUsuario" text="ID" prefWidth="70.0" />
                        <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="150.0" />
                        <TableColumn fx:id="colMaestroRelacionado" text="Maestro" prefWidth="190.0" />
                        <TableColumn fx:id="colRolesUsuario" text="Rol(es)" prefWidth="180.0" />
                        <TableColumn fx:id="colEstatusUsuario" text="Estatus" prefWidth="120.0" />
                        <TableColumn fx:id="colAccionUsuario" text="Accion" prefWidth="140.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </VBox>
            </VBox>

         </HBox>
      </VBox>
   </center>
</BorderPane>